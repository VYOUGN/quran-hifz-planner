<?xml version="1.0" encoding="utf-8"?>
<!-- The «ملوّن» widget background of the graphite design: its tint stops, as in Designs.kt. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#FF2F3437"
        android:endColor="#FF3D4347"
        android:startColor="#FF1F2326"
        android:type="linear" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
