<?xml version="1.0" encoding="utf-8"?>
<!-- The «ملوّن» widget background of the teal design: its tint stops, as in Designs.kt. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#FF006070"
        android:endColor="#FF007485"
        android:startColor="#FF004A5A"
        android:type="linear" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
